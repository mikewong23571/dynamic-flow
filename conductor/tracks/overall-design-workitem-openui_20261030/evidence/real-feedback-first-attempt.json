    "source": "root = Workspace(\"本周客户来件处理\", [views])\n$selected = []\n$draft = {}\nviews = ViewNavigation(\"tabs\", [recordsView, noteView, gapsView])\nrecordsView = View(\"处理记录\", [records, hint])\nhint = TextContent(\"记录来自已发布交付；本轮尚未正式运行，因此暂无交付记录。先在应用中确认方案与输入，再决定是否执行。\")\nrecords = Records(\"records\", \"来件处理记录（编号 / 性质 / 状态 / 后续动作）\", \"id\", [Field(\"id\", \"编号\"), Field(\"category\", \"性质\"), Field(\"status\", \"状态\"), Field(\"urgency\", \"紧急度\")], $selected, [continueBtn], [Field(\"originalText\", \"客户原文\"), Field(\"followUpAction\", \"后续动作\"), Field(\"owner\", \"建议处理方\"), Field(\"missingInfo\", \"缺失信息\")], \"status\")\ncontinueBtn = ActionButton(\"以所选记录准备下一轮\", @Run(continueStep))\ncontinueStep = Mutation(\"continue_records\", {output: \"records\", recordIds: $selected, inputPort: \"requestNotes\"})\nnoteView = View(\"补充信息\", [noteForm, noteHint])\nnoteHint = TextContent(\"仅补充客户尚未提供的事实（如 R2 的报错现象、R3 的使用频率）；未填写的项保持为缺口。\")\nnoteForm = InputForm(\"requestNotes\", \"补充来件缺失信息\", $draft, saveBtn, null, null, [\"requestId\", \"note\"])\nsaveBtn = ActionButton(\"保存补充信息\", @Run(saveNote))\nsaveNote = Mutation(\"submit_input\", {inputPort: \"requestNotes\", value: $draft})\ngapsView = View(\"缺口与下一步\", [gapText])\ngapText = TextContent(\"已知缺口：R2 缺报错现象、复现步骤与影响范围；R3 缺使用频率与批量规模；R1 是否需要对外回复未确认。完成要求待人工确认，本轮不执行、不发布交付。\")"
  },
