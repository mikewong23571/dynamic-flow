import {mkdir,writeFile} from 'node:fs/promises';
import assert from 'node:assert/strict';
const base='http://127.0.0.1:4331';const itemId='33800ab9-0d63-4484-92c3-936d8ff86d62';
const out='/home/mike/projs/fork/dynamic-flow-workitem-composition/conductor/tracks/workitem-composition_20261028/evidence/interface-model';await mkdir(out,{recursive:true});
const report:any={startedAt:new Date().toISOString(),itemId,scope:'真实默认模型，在独立预览上将明确虚构的演示改为一个固定方法调用及可操作界面。没有真实漏洞核查或修复。',turns:[]};
async function api(path:string,body?:unknown){const r=await fetch(base+path,body===undefined?undefined:{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});const j=await r.json() as any;if(!r.ok)throw Error(JSON.stringify(j));return j;}
async function turn(text:string){const started=Date.now();const receipt=await api(`/api/items/${itemId}/workspace/actions`,{action:'assistant',text});let last='';for(;;){const state=await api(`/api/items/${itemId}/workspace`);const m=state.work?.work.messages.find((m:any)=>m.role==='assistant'&&m.requestId===receipt.requestId);const p=JSON.stringify({status:m?.status,count:m?.activities?.length,tool:m?.activities?.at(-1)?.toolName});if(p!==last){console.log(p);last=p;}if(m&&['completed','failed','cancelled'].includes(m.status)){report.turns.push({durationMs:Date.now()-started,status:m.status,text:m.text,error:m.error,tools:m.activities?.map((a:any)=>({name:a.toolName,status:a.status,error:a.error}))});await writeFile(out+'/pending.json',JSON.stringify(report,null,2));assert.equal(m.status,'completed',m.error);return state;}if(Date.now()-started>360000)throw Error('模型超过6分钟，保留状态与错误');await new Promise(r=>setTimeout(r,1000));}}
try{
 const before=await api(`/api/items/${itemId}/workspace`);report.before={runs:before.work.work.runs.length,nodes:before.work.definitions[before.work.work.draftId].nodes.length};
 const state=await turn('请按最新产品方向重做这个明确虚构的演示安排。工作项必须薄：旧材料二里要求九步骤图已被本条取代，具体拆分归并核对都留在可复用流水线中。本项只保存一个call，调用目录中「演示·整批核对与交付」的固定保存版本，使用其batch输入与impact/changes/audit/completion输出。先查方法并检查完整合同和uiPlan模板。第一份材料里的alerts/assessments是唯一虚构业务输入，用read_artifact读取完整内容，add_input到batch并精确引用第一份materialId。保持第二份只作历史参考。重点是让人能在成果页操作：沿用方法模板保存四个视图、分组和详情，补核查依据/明确确认例外均绑定模板里现有固定方法与字段，review只进入人工核对；输入任务无需额外新造。用check_flow与check_ui_plan检查，再save_flow/save_ui_plan。设置两项未确认完成要求：全部原告警有适用范围的依据且例外已明确确认；已核对改动范围、固定来源及最终交付。不要自动确认。此轮只规划，不执行、不发布假结果。请用工具完成保存，最后简短告诉我能看什么、怎么推进。');
 const d=state.work.definitions[state.work.work.draftId];assert.equal(d.nodes.length,1,'工作项应仅一个固定call');assert.equal(d.nodes[0].kind,'call');assert.equal(state.work.work.runs.length,report.before.runs,'本轮只规划');assert.equal(state.uiPlan.views.length,4);assert.ok(state.uiPlan.views.some((v:any)=>v.actions?.some((a:any)=>a.kind==='input')));assert.ok(state.uiPlan.views.some((v:any)=>v.actions?.some((a:any)=>a.kind==='review')));assert.ok(state.item.criteria.every((c:any)=>!c.met));
 report.planned={definition:d,uiPlan:state.uiPlan,inputSelections:state.item.compositionInputs,criteria:state.item.criteria};
 const bound=await turn('现在明确执行刚保存的安排。启动已有处理方法，检查真实Run状态，成功后用publish_ui_plan将已保存的四个业务视图一次绑定到该Run的真实输出。遇到执行或绑定问题如实检查修正。不要新增漏洞判断、不要填人类表单、不要确认例外或完成条件、不要结项。只简短报告实际覆盖与缺口，后续由我在页面补依据与明确确认。');
 assert.equal(bound.deliveries.length,4);assert.equal(bound.item.status,'open');assert.ok(bound.item.criteria.every((c:any)=>!c.met));report.bound={deliveries:bound.deliveries.map((d:any)=>({id:d.id,presentation:d.presentation,rowCount:d.rows?.length,value:d.value})),runs:bound.work.work.runs.map((r:any)=>({id:r.id,status:r.status,definitionId:r.definitionId}))};
 report.url=`http://10.134.94.200:4330/items/${itemId}?tab=results`;report.completedAt=new Date().toISOString();console.log(JSON.stringify({url:report.url,turns:report.turns.map((t:any)=>({status:t.status,durationMs:t.durationMs,tools:t.tools?.length})),deliveries:bound.deliveries.length}));
}catch(e){report.error=String(e);console.log('MODEL_EVIDENCE_ERROR',String(e));process.exitCode=1;}finally{await writeFile(out+'/result.json',JSON.stringify(report,null,2));}
