    "rules": [
      "@layer components {\n  .app-shell { display: flex; height: 100dvh; min-height: 550px; overflow: hidden; }\n  .sidebar { width: 216px; flex: 0 0 auto; display: flex; flex-direction: column; background: var(--canvas); color: var(--ink); border-right: 1px solid var(--line); padding: 20px 12px 14px; }\n  .",
