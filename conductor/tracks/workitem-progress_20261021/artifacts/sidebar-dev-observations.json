      "@media (max-width: 1050px) {\n  @layer components {\n  .sidebar { width: 192px; }\n  .context-panel { width: 284px; }\n  .workspace-header { gap: 10px; padding: 15px 16px; }\n  .work-title h1 { max-width: 245px; }\n  .header-actions select { max-width: 100px; font-size: 10px; }\n}\n  .header-actions .button"
    ]
