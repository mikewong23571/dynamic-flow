{
  "name": "dynamic-flow-component-spike",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx examples/component-spike/server.ts",
    "dev:web": "vite --config examples/component-spike/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config examples/component-spike/vite.config.ts",
    "test": "tsx --test examples/component-spike/*.test.ts",
    "test:browser": "playwright test --config examples/component-spike/playwright.config.ts",
    "preview": "vite preview --config examples/component-spike/vite.config.ts --host 127.0.0.1 --port 4319",
    "format": "prettier --write \"examples/component-spike/**/*.{ts,tsx,css,html}\" package.json tsconfig.json components.json",
    "format:check": "prettier --check \"examples/component-spike/**/*.{ts,tsx,css,html}\" package.json tsconfig.json components.json"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.21",
    "@assistant-ui/react-markdown": "0.14.16",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@hono/node-server": "2.1.1",
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-table": "9.2.4",
    "@uiw/react-json-view": "2.0.0-alpha.43",
    "@xyflow/react": "12.11.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.8",
    "lucide-react": "1.47.0",
    "monaco-editor": "0.56.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-arborist": "3.16.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
