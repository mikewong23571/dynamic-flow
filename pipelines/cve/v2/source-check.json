              },
              "conclusion": {
                "type": "string",
                "enum": [
                  "受影响",
                  "不受影响",
                  "证据不足"
                ]
              },
              "reason": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "lines": {
                      "type": "string"
                    },
                    "commit": {
                      "type": "string"
                    },
                    "excerpt": {
                      "type": "string"
                    },
                    "finding": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "file",
