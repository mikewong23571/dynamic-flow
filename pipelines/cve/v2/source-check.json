              }
            },
            "required": [
              "target",
              "repository",
              "requestedRef",
              "commit",
              "conclusion",
              "reason",
              "evidence",
              "unknown"
            ],
            "additionalProperties": false
          }
        }
      },
      {
        "id": "summary",
        "label": "汇总本轮结果",
        "kind": "function",
        "operation": "aggregate",
        "expression": {
          "kind": "object",
          "fields": {
            "title": {
              "kind": "literal",
              "value": "本轮源码核查结果已汇集"
            },
            "summary": {
              "kind": "literal",
              "value": "已汇集本轮选定目标的逐项核查记录。下方统计各记录的判断，具体结论与依据仍需人工复核。"
            },
            "scope": {
              "kind": "literal",
              "value": "仅覆盖本轮固定输入所选目标；不代表其它轮次或全部业务范围。"
            },
            "metrics": {
              "kind": "array",
